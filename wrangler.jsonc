{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/react-start/server-entry",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kraken-vault-db",
      "database_id": "2e1c02c5-4083-4045-bd0d-aa9167196adf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "kraken-vault-assets"
    }
  ],
  "vars": {
    "ADMIN_SECRET": "M9640940"
  }
}
