{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/react-start/server-entry",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kraken-vault-db",
      "database_id": "placeholder-replace-with-real-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "kraken-vault-assets"
    }
  ],
  "vars": {
    "ADMIN_SECRET": "change-me-before-deploy",
    "RESEND_API_KEY": "re_your_resend_api_key_here",
    "APP_URL": "https://your-worker.workers.dev",
    "FROM_EMAIL": "noreply@kbkcompanies.com",
    "FROM_NAME": "Kraken Vault"
  }
}
